# LOCAL DEVELOPMENT ONLY. Docker services bind to loopback.
DATABASE_URL=postgresql+asyncpg://vi:vi_local@127.0.0.1:15432/viws
POSTGRES_USER=vi
POSTGRES_PASSWORD=vi_local
POSTGRES_DB=viws
REDIS_URL=redis://127.0.0.1:16379/0
MINIO_ROOT_USER=vi_local
MINIO_ROOT_PASSWORD=vi_local_storage_only
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_BUCKET=vi-websync-local
MLFLOW_TRACKING_URI=http://127.0.0.1:15000
INFERENCE_URL=http://127.0.0.1:8001
VITE_API_URL=http://127.0.0.1:8000

# Project-specific host ports avoid other apps; keep URL settings above in sync.
POSTGRES_PORT=15432
REDIS_PORT=16379
S3_PORT=19000
S3_CONSOLE_PORT=19001
MLFLOW_PORT=15000

# Optional tools (development only)
API_PORT=8000
AI_API_PORT=8001
PGADMIN_PORT=15050
PGADMIN_EMAIL=developer@example.com
PGADMIN_PASSWORD=local_pgadmin_only
