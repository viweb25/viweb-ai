{
	admin off
}

{$BACKEND_SITE} {
	@frontend {
		path /api/v1/auth/login /api/v1/auth/signup /api/v1/auth/me /api/v1/auth/logout /api/v1/function-templates /health/live
		header X-VI-Gateway-Key {$VI_GATEWAY_KEY}
	}
	handle @frontend {
		request_body {
			max_size 16KB
		}
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.request.header.X-VI-Client-IP}
			header_up -X-VI-Gateway-Key
			header_up -X-VI-Client-IP
		}
	}
	@inspection {
		path /api/v1/demo/inspect /api/v1/demo/detect /api/v1/demo/detection-model
		header X-VI-Gateway-Key {$VI_GATEWAY_KEY}
	}
	handle @inspection {
		request_body {
			max_size 5MiB
		}
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {http.request.header.X-VI-Client-IP}
			header_up -X-VI-Gateway-Key
			header_up -X-VI-Client-IP
		}
	}
	handle {
		respond 404
	}
}
