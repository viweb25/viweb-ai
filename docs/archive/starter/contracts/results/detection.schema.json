{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vi-websync/results/detection/v1",
  "title": "Object detection result",
  "type": "object",
  "required": ["result_id", "function_id", "model_version", "timestamp", "status", "objects"],
  "properties": {
    "result_id": { "type": "string", "description": "UUIDv7 created where inference ran (edge or worker)" },
    "function_id": { "type": "string" },
    "model_version": { "type": "string", "description": "e.g. 'zero-shot:owlv2-base' or 'od-1.2'" },
    "asset_id": { "type": ["string", "null"] },
    "sequence": { "type": ["integer", "null"], "description": "PLC/trigger sequence number" },
    "timestamp": { "type": "string", "format": "date-time" },
    "status": { "enum": ["OK", "NOT_OK", "ERROR", "TIMEOUT"], "description": "ERROR/TIMEOUT must never be treated as OK" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_id", "class_name", "confidence", "box"],
        "properties": {
          "class_id": { "type": "string" },
          "class_name": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4,
                   "description": "[x_min, y_min, x_max, y_max] in pixels of the original image" }
        }
      }
    },
    "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "rule_failures": { "type": "array", "items": { "type": "string" } },
    "latency_ms": { "type": "integer" },
    "evidence_uri": { "type": ["string", "null"] }
  }
}
