{
  "type": "object_detection",
  "version": 1,
  "title": "Object Detection",
  "description": "Detect and locate objects in images or live camera streams.",
  "schema": {
    "type": "object",
    "required": ["name", "classes", "inference"],
    "properties": {
      "name": { "type": "string", "title": "Function name", "minLength": 3 },
      "description": { "type": "string", "title": "Description" },
      "detection_mode": { "type": "string", "title": "Detection mode", "enum": ["image", "video", "live_camera"], "default": "image" },
      "asset_ids": { "type": "array", "title": "Cameras", "items": { "type": "string" } },
      "classes": {
        "type": "array", "title": "Classes (what the AI must find)", "minItems": 1,
        "items": {
          "type": "object", "required": ["class_id", "name"],
          "properties": {
            "class_id": { "type": "string", "title": "Class ID", "pattern": "^C[0-9]{3}$" },
            "name": { "type": "string", "title": "Class name" },
            "description": { "type": "string", "title": "Description (also used as text prompt for the existing AI)" },
            "color": { "type": "string", "title": "Color", "default": "#1B7F79" },
            "min_confidence": { "type": "number", "title": "Minimum confidence", "minimum": 0, "maximum": 1, "default": 0.5 },
            "expected_quantity": { "type": ["integer", "null"], "title": "Expected quantity (optional)", "minimum": 0 }
          }
        }
      },
      "inference": {
        "type": "object", "title": "Inference",
        "properties": {
          "min_confidence": { "type": "number", "title": "Global minimum confidence", "minimum": 0, "maximum": 1, "default": 0.5 },
          "max_objects": { "type": "integer", "title": "Maximum objects", "minimum": 1, "maximum": 500, "default": 50 },
          "resolution": { "type": "integer", "title": "Inference resolution (px)", "enum": [640, 960, 1280], "default": 960 }
        }
      },
      "model_source": { "type": "string", "title": "Model", "enum": ["existing_zero_shot", "trained"], "default": "existing_zero_shot" }
    }
  },
  "ui_schema": {
    "ui:order": ["name", "description", "detection_mode", "asset_ids", "classes", "inference", "model_source"],
    "description": { "ui:widget": "textarea" },
    "classes": { "items": { "color": { "ui:widget": "color" } } }
  },
  "output_contract": "contracts/results/detection.schema.json",
  "annotation_tools": ["box", "polygon", "ignore_region"],
  "metrics": ["mAP50", "mAP50_95", "precision", "recall"]
}
